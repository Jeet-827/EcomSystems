# =================================================================
# 🛒 SINGLE DOMAIN VERCEL DEPLOYMENT - MASTER ENVIRONMENT TEMPLATE
# Add these variables in Vercel Project Settings -> Environment Variables
# =================================================================

# Server & Node Configuration
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas Connection String)
MONGO_URL=your_mongodb_atlas_connection_string

# Authentication & JWT Secrets
SECRET_ONE=your_jwt_access_secret_key
SECRET_TWO=your_jwt_refresh_secret_key
ADMINKEY=your_admin_secret_key

# ImageKit Credentials (Product Image Uploads)
publicKey=your_imagekit_public_key
privateKey=your_imagekit_private_key
urlEndpoint=https://ik.imagekit.io/your_imagekit_id

# Razorpay Credentials (Payment Processing)
RAZOR_1=your_razorpay_key_id
RAZOR_2=your_razorpay_key_secret
